{
  "name": "abiba-capstone-analytics",
  "version": "1.0.0",
  "description": "EMBA capstone on crude oil production and evacuation analytics",
  "author": "Abiba Badmus",
  "entrypoint": {
    "source": "abiba_capstone_v2.qmd",
    "output": "abiba_capstone_v2.html"
  },
  "runtime": {
    "quarto": ">=1.3.0",
    "r": ">=4.3.0",
    "python": ">=3.10"
  },
  "python": {
    "requirements_file": "requirements.txt"
  },
  "r": {
    "packages": [
      "readr",
      "dplyr",
      "tidyr",
      "tibble",
      "purrr",
      "forcats",
      "ggplot2",
      "lubridate",
      "scales",
      "patchwork",
      "broom",
      "knitr",
      "sandwich",
      "lmtest",
      "reticulate"
    ]
  },
  "data_policy": {
    "raw_data_tracked_in_git": false,
    "required_local_files": [
      "data/daily production report.csv",
      "data/evacuation_report.csv"
    ],
    "keep_structure_with_gitkeep": true
  },
  "render": {
    "command": "QUARTO_PYTHON=.venv/bin/python quarto render abiba_capstone_v2.qmd"
  }
}
